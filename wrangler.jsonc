{
  "name": "tutoring",
  "main": "worker.js",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Only the parent page goes through the Worker (to put the student's name in the
    // link preview). Every other file is served straight from the assets, as before.
    "run_worker_first": ["/student", "/student.html"]
  },
  "observability": { "enabled": true }
}
